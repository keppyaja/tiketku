<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <script>
    document.querySelector('meta[name="color-scheme"]').content = localStorage.getItem("theme") ?? "light dark";
  </script>
  <title><%= title %> · TiketKu</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="nav">
  <div class="container nav-inner">
    <a class="brand" href="/">TiketKu</a>
    <div class="nav-links">
      <a href="/">Event</a>
      <% if (currentUser) { %>
        <a href="/orders"><%= currentUser.role === "admin" ? "Riwayat Pesanan" : "Pesanan Saya" %></a>
        <% if (currentUser.role === "admin") { %>
          <a href="/admin">Admin</a>
        <% } %>
        <form action="/logout" method="POST" class="inline">
          <a class="profile-link" href="/profile">
            <% if (currentUser.avatar_url) { %>
              <img class="nav-avatar" src="<%= currentUser.avatar_url %>" alt="">
            <% } else { %>
              <span class="nav-avatar avatar-fallback" aria-hidden="true"><%= (currentUser.username || currentUser.name).slice(0, 1).toUpperCase() %></span>
            <% } %>
            <span><%= currentUser.username || currentUser.name %></span>
          </a>
          <button class="btn btn-sm btn-outline" type="submit">Logout</button>
        </form>
      <% } else { %>
        <a href="/login">Login</a>
        <a class="btn btn-sm" href="/register">Daftar</a>
      <% } %>
      <button class="btn btn-sm btn-outline theme-toggle" id="theme-toggle" type="button" aria-label="Aktifkan tema gelap" aria-pressed="false">🌙</button>
    </div>
  </div>
</nav>
<main class="container">
  <% if (flash) { %>
    <div class="alert alert-<%= flash.type %>"><%= flash.text %></div>
  <% } %>
